# External environment only. Do not create repo-local virtualenvs or caches.
PROJECT_VENV_ROOT=${HOME}/venvs/juryrig
UV_PROJECT_ENVIRONMENT=${HOME}/venvs/juryrig
WINEPREFIX=$HOME/.wine-juryrig
PYTHONDONTWRITEBYTECODE=1
PYTHONPYCACHEPREFIX=/tmp/juryrig-pycache
PYTEST_ADDOPTS="-p no:cacheprovider"
UV_CACHE_DIR=/tmp/uv-cache-juryrig
RUFF_CACHE_DIR=/tmp/ruff-cache-juryrig
